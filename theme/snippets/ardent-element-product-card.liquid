{% doc %}
  Renders a real Shopify product inside an Ardent elemental collection.
  @param {product} product - Published product to display.
  @param {number} index - Position within the collection.
{% enddoc %}
<article class="ae-depth-card">
  <a class="ae-depth-card__visual" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if product.featured_image != blank %}
      {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320, 480, 720, 960, 1200', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 44vw, 78vw', class: 'ae-depth-card__image' }}
    {% else %}
      <span class="ae-depth-card__empty" aria-hidden="true">A</span>
    {% endif %}
    <span class="ae-depth-card__index" aria-hidden="true">{% if index < 10 %}0{% endif %}{{ index }}</span>
  </a>
  <div class="ae-depth-card__body">
    <h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
    <p class="ae-depth-card__price">
      {% if product.price_varies %}{{ 'ardent_elements.collection.from' | t }} {% endif %}{{ product.price | money }}
      {% unless product.available %}<span class="ae-depth-card__availability">{{ 'ardent_elements.collection.unavailable' | t }}</span>{% endunless %}
    </p>
    <a class="ae-depth-link" href="{{ product.url }}">{{ 'ardent_elements.collection.discover' | t }} <span aria-hidden="true">↗</span></a>
  </div>
</article>
