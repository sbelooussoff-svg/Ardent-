{% liquid
  assign models = 'meridian,bastille,elysee' | split: ','
  assign elements = 'fire,water,air' | split: ','
  assign titles = 'Méridian,Bastille,Élysée' | split: ','
  assign base_url = routes.root_url
  assign last_character = base_url | slice: -1, 1
  unless last_character == '/'
    assign base_url = base_url | append: '/'
  endunless
%}
<ardent-elements-home class="ae-home" data-element="fire" data-dwell="{{ section.settings.dwell | times: 1000 }}" style="--ae-dwell:{{ section.settings.dwell }}s" data-pause-text="{{ 'ardent_elements.home.pause' | t | escape }}" data-play-text="{{ 'ardent_elements.home.play' | t | escape }}">
  <section class="ae-hero" aria-roledescription="{{ 'ardent_elements.home.carousel' | t | escape }}" aria-label="{{ 'ardent_elements.home.title' | t | escape }}">
    <div class="ae-scenes" aria-hidden="true">
      <div class="ae-scene ae-scene--fire is-active" data-scene="0" style="--ae-scene-image:url('{{ 'meridian-fire-higgsfield-v2.png' | asset_url }}')"><video muted loop playsinline preload="none" aria-hidden="true" data-scene-video><source src="{{ 'meridian-fire-higgsfield-v2.mp4' | asset_url }}" type="video/mp4"></video></div>
      <div class="ae-scene ae-scene--water" data-scene="1" style="--ae-scene-image:url('{{ 'bastille-water-higgsfield-v2.png' | asset_url }}')"><video muted loop playsinline preload="none" aria-hidden="true" data-scene-video><source src="{{ 'bastille-water-higgsfield-v2.mp4' | asset_url }}" type="video/mp4"></video></div>
      <div class="ae-scene ae-scene--air" data-scene="2" style="--ae-scene-image:url('{{ 'elysee-air-higgsfield-v2.png' | asset_url }}')"><video muted loop playsinline preload="none" aria-hidden="true" data-scene-video><source src="{{ 'elysee-air-higgsfield-v2.mp4' | asset_url }}" type="video/mp4"></video></div>
    </div>
    <div class="ae-hero__veil" aria-hidden="true"></div>
    <div class="ae-hero__top"><span>ARDENT — {{ 'ardent_elements.home.edition' | t }}</span><span>{{ 'ardent_elements.home.three' | t }}</span></div>
    <h1 class="ae-sr">{{ 'ardent_elements.home.title' | t }}</h1>
    <div class="ae-hero__copy">
      {% for model in models %}
        {% assign eyebrow_key = 'ardent_elements.home.' | append: elements[forloop.index0] %}
        {% assign hook_key = 'ardent_elements.home.' | append: model | append: '_hook' %}
        {% assign body_key = 'ardent_elements.home.' | append: model | append: '_body' %}
        <div class="ae-copy{% if forloop.first %} is-active{% endif %}" data-copy="{{ forloop.index0 }}"{% unless forloop.first %} aria-hidden="true" inert{% endunless %}>
          <p class="ae-kicker"><span class="ae-dot"></span>0{{ forloop.index }} / {{ eyebrow_key | t }}</p>
          <h2>{{ titles[forloop.index0] }}</h2>
          <p class="ae-copy__hook">{{ hook_key | t }}</p>
          <p class="ae-copy__body">{{ body_key | t }}</p>
          <div class="ae-actions">
            <a class="ae-button ae-button--solid" href="{{ base_url }}collections/{{ model }}">{{ 'ardent_elements.home.watches' | t }} <span aria-hidden="true">↗</span></a>
            <a class="ae-button" href="{{ base_url }}pages/configurateur?model={{ model }}">{{ 'ardent_elements.home.configure' | t }} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="ae-orbit" data-orbit aria-hidden="true">
      <div class="ae-orbit__aura"></div>
      {% for model in models %}
        {% capture photo %}{% render 'ardent-element-media', model: model, context: 'hero' %}{% endcapture %}
        <figure class="ae-orbit__watch{% if forloop.first %} is-active{% endif %}" data-watch="{{ forloop.index0 }}">
          <img src="{{ photo | strip }}" alt="" width="1024" height="1536" fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">
        </figure>
      {% endfor %}
    </div>
    <div class="ae-hero__bottom">
      <a class="ae-scroll" href="#ArdentManifesto-{{ section.id }}"><span aria-hidden="true">↓</span>{{ 'ardent_elements.home.scroll' | t }}</a>
      <div class="ae-universes" aria-label="{{ 'ardent_elements.home.choose' | t | escape }}">
        {% for model in models %}<button type="button" data-world-choice="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><span class="ae-universes__number">0{{ forloop.index }}</span><span>{{ titles[forloop.index0] }}</span><i></i></button>{% endfor %}
      </div>
      <button type="button" class="ae-pause" data-pause aria-pressed="false" aria-label="{{ 'ardent_elements.home.pause' | t | escape }}"><span data-pause-symbol aria-hidden="true">Ⅱ</span><span class="ae-sr" data-pause-label>{{ 'ardent_elements.home.pause' | t }}</span></button>
    </div>
    <p class="ae-sr" role="status" data-world-status></p>
  </section>
  <section class="ae-manifesto" id="ArdentManifesto-{{ section.id }}">
    <p class="ae-kicker">{{ 'ardent_elements.home.manifesto_kicker' | t }}</p>
    <h2>{{ 'ardent_elements.home.manifesto_title' | t }}</h2>
    <p class="ae-manifesto__body">{{ 'ardent_elements.home.manifesto_body' | t }}</p>
    <div class="ae-editorial-grid">
      {% for model in models %}
        {% capture cover %}{% render 'ardent-element-media', model: model, context: 'collection' %}{% endcapture %}
        {% assign hook_key = 'ardent_elements.home.' | append: model | append: '_hook' %}
        {% assign eyebrow_key = 'ardent_elements.home.' | append: elements[forloop.index0] %}
        <a class="ae-editorial-card ae-editorial-card--{{ elements[forloop.index0] }}" href="{{ base_url }}collections/{{ model }}" style="--reveal-delay:{{ forloop.index0 | times: 100 }}ms">
          <div class="ae-editorial-card__picture"><img src="{{ cover | strip }}" alt="{{ titles[forloop.index0] }}" width="1122" height="1402" loading="lazy" decoding="async"><video muted loop playsinline preload="none" aria-hidden="true" data-product-video><source src="{{ 'ardent-' | append: model | append: '-product-motion-v3.mp4' | asset_url }}" type="video/mp4"></video></div>
          <div class="ae-editorial-card__copy"><span class="ae-editorial-card__index">0{{ forloop.index }} / {{ eyebrow_key | t }}</span><h3>{{ titles[forloop.index0] }}</h3><p>{{ hook_key | t }}</p><span class="ae-editorial-card__arrow" aria-hidden="true">↗</span></div>
        </a>
      {% endfor %}
    </div>
    <p class="ae-visual-note">{{ 'ardent_elements.home.visual_note' | t }}</p>
  </section>
  <section class="ae-signature">
    <p class="ae-kicker">{{ 'ardent_elements.home.signature_kicker' | t }}</p>
    <h2>{{ 'ardent_elements.home.signature_title' | t }}</h2>
    <div class="ae-signature__line" aria-hidden="true"></div>
    <p>{{ 'ardent_elements.home.signature_body' | t }}</p>
    <a class="ae-button" href="{{ base_url }}pages/le-geste-ardent">{{ 'ardent_elements.home.craft' | t }} <span aria-hidden="true">↗</span></a>
  </section>
</ardent-elements-home>
{% stylesheet %}
  .ae-home{display:block;background:#080a0e;color:#f2ece3;--ae-accent:#e7b38c;--ae-font:var(--font-heading--family,Georgia,serif)}
  .ae-home[data-element=water]{--ae-accent:#a4d8dc}.ae-home[data-element=air]{--ae-accent:#e2e8f4}
  .ae-home *{box-sizing:border-box}.ae-home a{color:inherit;text-decoration:none}.ae-home button{font:inherit}.ae-home :is(a,button):focus-visible{outline:2px solid currentColor;outline-offset:6px}
  .ae-sr{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .ae-hero{height:calc(100svh - var(--header-group-height,110px));min-height:690px;max-height:1180px;position:relative;isolation:isolate;overflow:hidden;background:#0e1012;touch-action:pan-y}
  .ae-scenes{position:absolute;inset:0;z-index:-3;background:#101215}.ae-scene{position:absolute;inset:0;background-image:var(--ae-scene-image);background-size:cover;background-position:center;opacity:0;transform:scale(1.06);transition:opacity .75s ease,transform 2.2s cubic-bezier(.2,.6,.2,1);will-change:opacity,transform;overflow:hidden}.ae-scene.is-active{opacity:1;transform:scale(1)}.ae-scene--water{background-position:center 56%}.ae-scene--air{background-position:center 43%}.ae-scene::before,.ae-scene::after{content:"";position:absolute;inset:-12%;pointer-events:none;will-change:transform,opacity}.ae-scene--fire::before{background:radial-gradient(circle at 16% 80%,#ffb35a7d 0 1px,transparent 3px),radial-gradient(circle at 34% 64%,#ffc0828c 0 1px,transparent 3px),radial-gradient(circle at 61% 90%,#ff975084 0 1.5px,transparent 4px),radial-gradient(circle at 83% 70%,#ffd59a6b 0 1px,transparent 3px),radial-gradient(ellipse at 68% 93%,#a34a2950,transparent 57%);background-size:330px 260px,470px 340px,550px 410px,390px 290px,100% 100%;animation:ae-embers 7s linear infinite}.ae-scene--fire::after{background:radial-gradient(ellipse at 70% 75%,#df6c3a30,transparent 56%);filter:blur(28px);animation:ae-heat 5s ease-in-out infinite alternate}.ae-scene--water::before{background:repeating-linear-gradient(108deg,transparent 0 7%,#aadce622 8%,transparent 10% 17%);filter:blur(18px);mix-blend-mode:screen;animation:ae-caustic 8s ease-in-out infinite alternate}.ae-scene--water::after{background:radial-gradient(circle at 62% 75%,#dbfcff80 0 1px,transparent 3px),radial-gradient(circle at 42% 60%,#e3feff73 0 1px,transparent 3px),radial-gradient(circle at 83% 87%,#dffcff65 0 1.5px,transparent 4px);background-size:320px 280px,480px 420px,620px 450px;animation:ae-bubbles 9s linear infinite}.ae-scene--air::before{background:radial-gradient(ellipse at 78% 30%,#f7faff66,transparent 47%),radial-gradient(ellipse at 28% 85%,#eef5ff42,transparent 54%);filter:blur(24px);animation:ae-clouds 11s ease-in-out infinite alternate}.ae-scene--air::after{background:linear-gradient(112deg,transparent 27%,#fff7 51%,transparent 72%);filter:blur(36px);opacity:.25;animation:ae-sky-light 8s ease-in-out infinite alternate}.ae-hero__veil{position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,rgba(5,6,9,.89) 0%,rgba(5,6,9,.64) 29%,rgba(5,6,9,.24) 63%,rgba(5,6,9,.10)),linear-gradient(0deg,rgba(3,5,9,.88),transparent 28%,rgba(4,6,9,.14))}
  .ae-scene::before,.ae-scene::after{z-index:1}.ae-scene video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .35s ease;pointer-events:none}.ae-scene.is-playing video{opacity:1}.ae-scene--water video{object-position:center 56%}.ae-scene--air video{object-position:center 43%}
  .ae-hero__top{position:absolute;inset:32px 4.5vw auto;display:flex;justify-content:space-between;font-size:9px;letter-spacing:.2em;z-index:4;color:#fff9;text-transform:uppercase}
  .ae-hero__copy{position:absolute;left:7vw;top:50%;width:43%;transform:translateY(-50%);z-index:5;display:grid;pointer-events:none}
  .ae-copy{grid-area:1/1;opacity:0;transform:translateY(24px);transition:opacity .38s,transform .65s cubic-bezier(.2,.75,.2,1);visibility:hidden}.ae-copy.is-active{opacity:1;transform:none;visibility:visible;pointer-events:auto;transition-delay:.12s}
  .ae-kicker{font-size:10px;letter-spacing:.25em;text-transform:uppercase;display:flex;align-items:center;gap:13px;margin:0 0 32px;line-height:1.7;color:var(--ae-accent)}.ae-dot{width:5px;height:5px;background:currentColor;border-radius:50%;box-shadow:0 0 18px currentColor}
  .ae-copy h2{font-family:var(--ae-font);font-size:clamp(72px,8.7vw,146px);line-height:.95;letter-spacing:-.055em;font-weight:400;margin:0 0 26px;color:#fff7ed;text-transform:none}
  .ae-copy__hook{font-family:var(--ae-font);font-size:clamp(22px,2.5vw,37px);font-weight:400;letter-spacing:-.025em;line-height:1.15;margin:0 0 18px;color:#f1e4d5}
  .ae-copy__body{font-size:12px;line-height:1.8;letter-spacing:.025em;color:#eee5d0ad;max-width:34ch;margin:0 0 38px}
  .ae-actions{display:flex;gap:12px;flex-wrap:wrap}.ae-button{display:inline-flex;justify-content:space-between;align-items:center;gap:24px;border:1px solid #e8dfcc66;padding:17px 21px;font-size:11px;letter-spacing:.04em;line-height:1.5;background:#080a0b20;backdrop-filter:blur(6px);transition:background .3s,color .3s,transform .3s}.ae-button>span{font-size:17px}.ae-button--solid{background:#f2ebe0!important;color:#181915!important;border-color:#f2ebe0}.ae-button:hover{background:#e8dfcc20;transform:translateY(-2px)}.ae-button--solid:hover{background:#fff!important}
  .ae-orbit{position:absolute;inset:5% 1% 8% 45%;z-index:1;pointer-events:none;perspective:1200px}
  .ae-orbit__aura{position:absolute;inset:13% 4% 9%;background:radial-gradient(ellipse,var(--ae-accent),transparent 68%);opacity:.12;filter:blur(45px);animation:ae-aura 4s ease-in-out infinite alternate;transition:background .7s}
  .ae-orbit__watch{position:absolute;margin:0;inset:0 12% 0;display:flex;align-items:center;justify-content:center;transition:transform .8s cubic-bezier(.2,.75,.2,1),opacity .7s,filter .7s;will-change:transform,opacity;transform:translateX(13%) rotateY(-12deg) scale(.88);opacity:0;filter:blur(12px);backface-visibility:hidden}.ae-orbit__watch.is-exiting{transform:translateX(-13%) rotateY(12deg) scale(.88)}
  .ae-orbit__watch.is-active{transform:translateY(0) scale(1);opacity:1;filter:blur(0)}.ae-orbit__watch img{max-height:98%;height:100%;width:100%;object-fit:contain;filter:drop-shadow(0 30px 44px #000a);animation:ae-watch-breath 9s ease-in-out infinite;mask-image:linear-gradient(0deg,transparent 0%,#000 7%,#000 96%,transparent 100%)}
  .ae-orbit__watch[data-watch="0"]:not(.is-active):not(.is-exiting){transform:translateY(14%) rotateY(-15deg) scale(.82)}.ae-orbit__watch[data-watch="0"].is-exiting{transform:translateY(-12%) rotateY(13deg) scale(.9)}.ae-orbit__watch[data-watch="1"]:not(.is-active):not(.is-exiting){transform:translateX(16%) rotateY(-10deg) scale(.86)}.ae-orbit__watch[data-watch="1"].is-exiting{transform:translateX(-14%) rotateY(10deg) scale(.87)}.ae-orbit__watch[data-watch="2"]:not(.is-active):not(.is-exiting){transform:translate(7%,-15%) rotate(4deg) scale(.85)}.ae-orbit__watch[data-watch="2"].is-exiting{transform:translate(-6%,11%) rotate(-3deg) scale(.89)}
  .ae-orbit__watch[data-watch="0"] img{animation:ae-watch-fire 7s ease-in-out infinite}.ae-orbit__watch[data-watch="1"] img{animation:ae-watch-water 9s ease-in-out infinite}.ae-orbit__watch[data-watch="2"] img{animation:ae-watch-air 11s ease-in-out infinite}
  .ae-hero__bottom{position:absolute;bottom:25px;left:4.5vw;right:4.5vw;display:grid;grid-template-columns:1fr auto 1fr;align-items:end;gap:28px;z-index:6}.ae-scroll{display:flex;align-items:center;gap:13px;font-size:9px;letter-spacing:.13em;opacity:.65}.ae-scroll>span{font-size:26px;animation:ae-down 2.5s ease-in-out infinite}
  .ae-universes{display:flex;gap:30px}.ae-universes button{position:relative;display:flex;gap:10px;align-items:center;padding:15px 0 18px;border:0;border-bottom:1px solid #ffffff2a;color:#ffffff68;background:none;font-size:11px;cursor:pointer;min-width:96px}.ae-universes button[aria-pressed=true]{color:#fff}.ae-universes__number{font-size:8px;color:var(--ae-accent)}.ae-universes i{position:absolute;bottom:-1px;left:0;height:1px;width:100%;transform:scaleX(0);transform-origin:left;background:var(--ae-accent)}.ae-universes button[aria-pressed=true] i{transform:scaleX(1);transition:transform var(--ae-dwell,6s) linear}
  .ae-pause{justify-self:end;border:1px solid #fff5;border-radius:50%;background:transparent;color:#fff;cursor:pointer;height:40px;width:40px;font-size:13px!important;display:grid;place-items:center}
  .ae-manifesto{background:#eeebe3;color:#24261f;padding:110px 6vw 80px;text-align:center}.ae-manifesto>.ae-kicker{justify-content:center;color:#8b7460}.ae-manifesto h2{font:400 clamp(38px,5.5vw,80px)/1.05 var(--ae-font);letter-spacing:-.04em;max-width:820px;margin:0 auto 25px;color:inherit}.ae-manifesto__body{max-width:48ch;margin:0 auto 65px;color:#625e53;font-size:13px;line-height:1.9}
  .ae-editorial-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(15px,2vw,34px);text-align:left;max-width:1500px;margin:auto}.ae-editorial-card{display:block;min-width:0;--ae-portrait-light:#9e6750;transition:transform 1s cubic-bezier(.2,.75,.2,1),opacity .9s;transition-delay:var(--reveal-delay)}.ae-editorial-card--water{--ae-portrait-light:#6b9da6}.ae-editorial-card--air{--ae-portrait-light:#a59bba}.ae-editorial-card__picture{aspect-ratio:4/5;position:relative;isolation:isolate;background:transparent}.ae-editorial-card__picture::before{content:"";position:absolute;inset:19% 8% 7%;border-radius:50%;background:radial-gradient(ellipse,var(--ae-portrait-light) 0%,transparent 67%);filter:blur(28px);opacity:.24;transform:scale(.9);animation:ae-portrait-light 8s ease-in-out infinite alternate}.ae-editorial-card__picture img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;mask-image:radial-gradient(ellipse 62% 64% at 50% 46%,#000 42%,#000e 56%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse 62% 64% at 50% 46%,#000 42%,#000e 56%,transparent 100%);transition:transform 1.4s cubic-bezier(.2,.65,.2,1),opacity 1.2s ease;transform:translateY(0) scale(1);opacity:1}.ae-home.is-enhanced .ae-editorial-card:not(.is-seen) .ae-editorial-card__picture img{opacity:0;transform:translateY(28px) scale(1.055)}.ae-editorial-card:hover .ae-editorial-card__picture img,.ae-editorial-card:focus-visible .ae-editorial-card__picture img{transform:translateY(-10px) scale(1.045)}.ae-editorial-card__copy{position:relative;margin-top:-8px;padding:15px 4px 26px;border-bottom:1px solid #7d71543b;transition:border-color .5s}.ae-editorial-card:hover .ae-editorial-card__copy,.ae-editorial-card:focus-visible .ae-editorial-card__copy{border-color:#584a39a8}.ae-editorial-card__index{display:block;margin-bottom:13px;font-size:9px;color:#7d756a;letter-spacing:.19em;text-transform:uppercase}.ae-editorial-card h3{font:400 clamp(26px,3vw,43px)/1.1 var(--ae-font);margin:0 0 12px;letter-spacing:-.03em;color:inherit}.ae-editorial-card__copy p{font-size:11px;line-height:1.7;color:#726d60;margin:0}.ae-editorial-card__arrow{position:absolute;right:4px;top:48px;font-size:22px;transition:transform .45s}.ae-editorial-card:hover .ae-editorial-card__arrow,.ae-editorial-card:focus-visible .ae-editorial-card__arrow{transform:translate(4px,-4px)}.ae-visual-note{font-size:9px;letter-spacing:.025em;color:#8b8375;margin:34px auto 0;line-height:1.7;max-width:700px}
  .ae-editorial-card__picture :is(img,video){z-index:1}.ae-editorial-card__picture video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;pointer-events:none;mask-image:radial-gradient(ellipse 62% 64% at 50% 46%,#000 42%,#000e 56%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse 62% 64% at 50% 46%,#000 42%,#000e 56%,transparent 100%);transition:opacity .6s ease,transform 1.2s ease}.ae-editorial-card__picture.is-playing video{opacity:1}.ae-editorial-card__picture::after{content:"";position:absolute;inset:11% 3%;z-index:2;pointer-events:none;opacity:.36;mask-image:radial-gradient(ellipse 65% 64% at 50% 48%,#000 43%,transparent 100%);-webkit-mask-image:radial-gradient(ellipse 65% 64% at 50% 48%,#000 43%,transparent 100%)}.ae-editorial-card--fire .ae-editorial-card__picture::after{background:radial-gradient(circle at 29% 76%,#ed9859 0 1px,transparent 4px),radial-gradient(circle at 73% 63%,#ffc274 0 1px,transparent 3px);background-size:160px 190px,210px 240px;animation:ae-embers 7s linear infinite}.ae-editorial-card--water .ae-editorial-card__picture::after{background:repeating-linear-gradient(110deg,transparent 0 12%,#d9f4ff8a 14%,transparent 17% 30%);filter:blur(12px);animation:ae-caustic 9s ease-in-out infinite alternate}.ae-editorial-card--air .ae-editorial-card__picture::after{background:linear-gradient(110deg,transparent 22%,#fff9 51%,transparent 70%);filter:blur(18px);animation:ae-sky-light 10s ease-in-out infinite alternate}.ae-editorial-card--fire:hover .ae-editorial-card__picture video{transform:scale(1.035) rotate(-1deg)}.ae-editorial-card--water:hover .ae-editorial-card__picture video{transform:translateY(-7px) scale(1.025)}.ae-editorial-card--air:hover .ae-editorial-card__picture video{transform:translate(5px,-5px) scale(1.03)}
  .ae-editorial-card__picture img{z-index:3;opacity:.93}.ae-editorial-card__picture video{z-index:1}.ae-editorial-card__picture.is-playing video{opacity:.8}.ae-editorial-card--fire.is-seen .ae-editorial-card__picture img{animation:ae-product-fire 7s ease-in-out infinite}.ae-editorial-card--water.is-seen .ae-editorial-card__picture img{animation:ae-product-water 9s ease-in-out infinite}.ae-editorial-card--air.is-seen .ae-editorial-card__picture img{animation:ae-product-air 11s ease-in-out infinite}
  .ae-signature{padding:115px 8vw 130px;text-align:center;background:radial-gradient(ellipse at 50% 130%,#403020,#10100e 64%);color:#f1e8da}.ae-signature>.ae-kicker{justify-content:center;color:#baa88e}.ae-signature h2{font:400 clamp(38px,5vw,73px)/1.12 var(--ae-font);letter-spacing:-.035em;margin:0 auto;max-width:850px;color:inherit}.ae-signature__line{width:1px;height:64px;margin:35px auto;background:linear-gradient(#baa88e,transparent)}.ae-signature>p:not(.ae-kicker){max-width:46ch;margin:0 auto 32px;font-size:13px;line-height:1.9;color:#baafa0}.ae-home.is-enhanced .ae-editorial-card:not(.is-seen){opacity:0;transform:translateY(45px)}
