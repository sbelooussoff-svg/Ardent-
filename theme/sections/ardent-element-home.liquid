{% liquid
  assign models = 'meridian,bastille,elysee' | split: ','
  assign elements = 'fire,water,air' | split: ','
  assign titles = 'Méridian,Bastille,Élysée' | split: ','
  assign base_url = routes.root_url
  assign last_character = base_url | slice: -1, 1
  unless last_character == '/'
    assign base_url = base_url | append: '/'
  endunless
%}
<ardent-elements-home class="ae-home" data-element="fire" data-dwell="{{ section.settings.dwell | times: 1000 }}" data-pause-text="{{ 'ardent_elements.home.pause' | t | escape }}" data-play-text="{{ 'ardent_elements.home.play' | t | escape }}">
  <section class="ae-hero" aria-roledescription="{{ 'ardent_elements.home.carousel' | t | escape }}" aria-label="{{ 'ardent_elements.home.title' | t | escape }}">
    <div class="ae-scenes" aria-hidden="true">
      <div class="ae-scene ae-scene--fire is-active" data-scene="0" style="--ae-scene-image:url('{{ 'meridian-fire-v1.jpg' | file_url }}')"></div>
      <div class="ae-scene ae-scene--water" data-scene="1" style="--ae-scene-image:url('{{ 'bastille-water-v1.jpg' | file_url }}')"></div>
      <div class="ae-scene ae-scene--air" data-scene="2" style="--ae-scene-image:url('{{ 'elysee-air-v1.jpg' | file_url }}')"></div>
    </div>
    <div class="ae-hero__veil" aria-hidden="true"></div>
    <div class="ae-hero__top"><span>ARDENT — {{ 'ardent_elements.home.edition' | t }}</span><span>{{ 'ardent_elements.home.three' | t }}</span></div>
    <h1 class="ae-sr">{{ 'ardent_elements.home.title' | t }}</h1>
    <div class="ae-hero__copy">
      {% for model in models %}
        {% assign eyebrow_key = 'ardent_elements.home.' | append: elements[forloop.index0] %}
        {% assign hook_key = 'ardent_elements.home.' | append: model | append: '_hook' %}
        {% assign body_key = 'ardent_elements.home.' | append: model | append: '_body' %}
        <div class="ae-copy{% if forloop.first %} is-active{% endif %}" data-copy="{{ forloop.index0 }}"{% unless forloop.first %} aria-hidden="true" inert{% endunless %}>
          <p class="ae-kicker"><span class="ae-dot"></span>0{{ forloop.index }} / {{ eyebrow_key | t }}</p>
          <h2>{{ titles[forloop.index0] }}</h2>
          <p class="ae-copy__hook">{{ hook_key | t }}</p>
          <p class="ae-copy__body">{{ body_key | t }}</p>
          <div class="ae-actions">
            <a class="ae-button ae-button--solid" href="{{ base_url }}collections/{{ model }}">{{ 'ardent_elements.home.watches' | t }} <span aria-hidden="true">↗</span></a>
            <a class="ae-button" href="{{ base_url }}pages/configurateur?model={{ model }}">{{ 'ardent_elements.home.configure' | t }} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="ae-orbit" data-orbit aria-hidden="true">
      <div class="ae-orbit__aura"></div>
      {% for model in models %}
        {% capture photo %}{% render 'ardent-element-media', model: model, context: 'hero' %}{% endcapture %}
        <figure class="ae-orbit__watch{% if forloop.first %} is-active{% endif %}" data-watch="{{ forloop.index0 }}">
          <img src="{{ photo | strip }}" alt="" width="1024" height="1536" fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">
        </figure>
      {% endfor %}
    </div>
    <div class="ae-hero__bottom">
      <a class="ae-scroll" href="#ArdentManifesto-{{ section.id }}"><span aria-hidden="true">↓</span>{{ 'ardent_elements.home.scroll' | t }}</a>
      <div class="ae-universes" aria-label="{{ 'ardent_elements.home.choose' | t | escape }}">
        {% for model in models %}<button type="button" data-world-choice="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><span class="ae-universes__number">0{{ forloop.index }}</span><span>{{ titles[forloop.index0] }}</span><i></i></button>{% endfor %}
      </div>
      <button type="button" class="ae-pause" data-pause aria-pressed="false" aria-label="{{ 'ardent_elements.home.pause' | t | escape }}"><span data-pause-symbol aria-hidden="true">Ⅱ</span><span class="ae-sr" data-pause-label>{{ 'ardent_elements.home.pause' | t }}</span></button>
    </div>
    <p class="ae-sr" role="status" data-world-status></p>
  </section>
  <section class="ae-manifesto" id="ArdentManifesto-{{ section.id }}">
    <p class="ae-kicker">{{ 'ardent_elements.home.manifesto_kicker' | t }}</p>
    <h2>{{ 'ardent_elements.home.manifesto_title' | t }}</h2>
    <p class="ae-manifesto__body">{{ 'ardent_elements.home.manifesto_body' | t }}</p>
    <div class="ae-editorial-grid">
      {% for model in models %}
        {% capture cover %}{% render 'ardent-element-media', model: model, context: 'collection' %}{% endcapture %}
        {% assign hook_key = 'ardent_elements.home.' | append: model | append: '_hook' %}
        <a class="ae-editorial-card" href="{{ base_url }}collections/{{ model }}" style="--reveal-delay:{{ forloop.index0 | times: 100 }}ms">
          <div class="ae-editorial-card__picture"><img src="{{ cover | strip }}" alt="{{ titles[forloop.index0] }}" width="1122" height="1402" loading="lazy" decoding="async"><span class="ae-editorial-card__index">0{{ forloop.index }}</span></div>
          <div class="ae-editorial-card__copy"><h3>{{ titles[forloop.index0] }}</h3><p>{{ hook_key | t }}</p><span aria-hidden="true">↗</span></div>
        </a>
      {% endfor %}
    </div>
    <p class="ae-visual-note">{{ 'ardent_elements.home.visual_note' | t }}</p>
  </section>
  <section class="ae-signature">
    <p class="ae-kicker">{{ 'ardent_elements.home.signature_kicker' | t }}</p>
    <h2>{{ 'ardent_elements.home.signature_title' | t }}</h2>
    <div class="ae-signature__line" aria-hidden="true"></div>
    <p>{{ 'ardent_elements.home.signature_body' | t }}</p>
    <a class="ae-button" href="{{ base_url }}pages/le-geste-ardent">{{ 'ardent_elements.home.craft' | t }} <span aria-hidden="true">↗</span></a>
  </section>
</ardent-elements-home>
{% stylesheet %}
  .ae-home{display:block;background:#080a0e;color:#f2ece3;--ae-accent:#e7b38c;--ae-font:var(--font-heading--family,Georgia,serif)}
  .ae-home[data-element=water]{--ae-accent:#a4d8dc}.ae-home[data-element=air]{--ae-accent:#e2e8f4}
  .ae-home *{box-sizing:border-box}.ae-home a{color:inherit;text-decoration:none}.ae-home button{font:inherit}.ae-home :is(a,button):focus-visible{outline:2px solid currentColor;outline-offset:6px}
  .ae-sr{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .ae-hero{height:calc(100svh - var(--header-group-height,110px));min-height:690px;max-height:1180px;position:relative;isolation:isolate;overflow:hidden;background:#0e1012;touch-action:pan-y}
  .ae-scenes{position:absolute;inset:0;z-index:-3;background:#101215}.ae-scene{position:absolute;inset:0;background-image:var(--ae-scene-image);background-size:cover;background-position:center;opacity:0;transform:scale(1.035);transition:opacity 1.3s ease,transform 8s ease;will-change:opacity}.ae-scene.is-active{opacity:1;transform:scale(1)}.ae-scene--water{background-position:center 56%}.ae-scene--air{background-position:center 43%}.ae-hero__veil{position:absolute;inset:0;z-index:-2;background:linear-gradient(90deg,rgba(5,6,9,.89) 0%,rgba(5,6,9,.64) 29%,rgba(5,6,9,.24) 63%,rgba(5,6,9,.10)),linear-gradient(0deg,rgba(3,5,9,.88),transparent 28%,rgba(4,6,9,.14))}
  .ae-hero__top{position:absolute;inset:32px 4.5vw auto;display:flex;justify-content:space-between;font-size:9px;letter-spacing:.2em;z-index:4;color:#fff9;text-transform:uppercase}
  .ae-hero__copy{position:absolute;left:7vw;top:50%;width:43%;transform:translateY(-50%);z-index:5;display:grid;pointer-events:none}
  .ae-copy{grid-area:1/1;opacity:0;transform:translateY(34px);transition:opacity .55s,transform 1s cubic-bezier(.2,.75,.2,1);visibility:hidden}.ae-copy.is-active{opacity:1;transform:none;visibility:visible;pointer-events:auto;transition-delay:.25s}
  .ae-kicker{font-size:10px;letter-spacing:.25em;text-transform:uppercase;display:flex;align-items:center;gap:13px;margin:0 0 32px;line-height:1.7;color:var(--ae-accent)}.ae-dot{width:5px;height:5px;background:currentColor;border-radius:50%;box-shadow:0 0 18px currentColor}
  .ae-copy h2{font-family:var(--ae-font);font-size:clamp(72px,8.7vw,146px);line-height:.95;letter-spacing:-.055em;font-weight:400;margin:0 0 26px;color:#fff7ed;text-transform:none}
  .ae-copy__hook{font-family:var(--ae-font);font-size:clamp(22px,2.5vw,37px);font-weight:400;letter-spacing:-.025em;line-height:1.15;margin:0 0 18px;color:#f1e4d5}
  .ae-copy__body{font-size:12px;line-height:1.8;letter-spacing:.025em;color:#eee5d0ad;max-width:34ch;margin:0 0 38px}
  .ae-actions{display:flex;gap:12px;flex-wrap:wrap}.ae-button{display:inline-flex;justify-content:space-between;align-items:center;gap:24px;border:1px solid #e8dfcc66;padding:17px 21px;font-size:11px;letter-spacing:.04em;line-height:1.5;background:#080a0b20;backdrop-filter:blur(6px);transition:background .3s,color .3s,transform .3s}.ae-button>span{font-size:17px}.ae-button--solid{background:#f2ebe0!important;color:#181915!important;border-color:#f2ebe0}.ae-button:hover{background:#e8dfcc20;transform:translateY(-2px)}.ae-button--solid:hover{background:#fff!important}
  .ae-orbit{position:absolute;inset:5% 1% 8% 45%;z-index:1;pointer-events:none}
  .ae-orbit__aura{position:absolute;inset:13% 4% 9%;background:radial-gradient(ellipse,var(--ae-accent),transparent 68%);opacity:.09;filter:blur(45px);transition:background 1.6s}
  .ae-orbit__watch{position:absolute;margin:0;inset:0 12% 0;display:flex;align-items:center;justify-content:center;transition:transform 1.2s cubic-bezier(.2,.75,.2,1),opacity .9s,filter .9s;will-change:transform;transform:translateY(3%) scale(.91);opacity:0;filter:blur(12px);backface-visibility:hidden}
  .ae-orbit__watch.is-active{transform:translateY(0) scale(1);opacity:1;filter:blur(0)}.ae-orbit__watch img{max-height:98%;height:100%;width:100%;object-fit:contain;filter:drop-shadow(0 30px 44px #000a);animation:ae-watch-breath 9s ease-in-out infinite;mask-image:linear-gradient(0deg,transparent 0%,#000 7%,#000 96%,transparent 100%)}
  .ae-hero__bottom{position:absolute;bottom:25px;left:4.5vw;right:4.5vw;display:grid;grid-template-columns:1fr auto 1fr;align-items:end;gap:28px;z-index:6}.ae-scroll{display:flex;align-items:center;gap:13px;font-size:9px;letter-spacing:.13em;opacity:.65}.ae-scroll>span{font-size:26px;animation:ae-down 2.5s ease-in-out infinite}
  .ae-universes{display:flex;gap:30px}.ae-universes button{position:relative;display:flex;gap:10px;align-items:center;padding:15px 0 18px;border:0;border-bottom:1px solid #ffffff2a;color:#ffffff68;background:none;font-size:11px;cursor:pointer;min-width:96px}.ae-universes button[aria-pressed=true]{color:#fff}.ae-universes__number{font-size:8px;color:var(--ae-accent)}.ae-universes i{position:absolute;bottom:-1px;left:0;height:1px;width:100%;transform:scaleX(0);transform-origin:left;background:var(--ae-accent)}.ae-universes button[aria-pressed=true] i{transform:scaleX(1);transition:transform 2s linear}
  .ae-pause{justify-self:end;border:1px solid #fff5;border-radius:50%;background:transparent;color:#fff;cursor:pointer;height:40px;width:40px;font-size:13px!important;display:grid;place-items:center}
  .ae-manifesto{background:#eeebe3;color:#24261f;padding:110px 6vw 80px;text-align:center}.ae-manifesto>.ae-kicker{justify-content:center;color:#8b7460}.ae-manifesto h2{font:400 clamp(38px,5.5vw,80px)/1.05 var(--ae-font);letter-spacing:-.04em;max-width:820px;margin:0 auto 25px;color:inherit}.ae-manifesto__body{max-width:48ch;margin:0 auto 65px;color:#625e53;font-size:13px;line-height:1.9}
  .ae-editorial-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:27px;text-align:left;max-width:1500px;margin:auto}.ae-editorial-card{display:block;min-width:0;transition:transform 1s cubic-bezier(.2,.75,.2,1),opacity .9s;transition-delay:var(--reveal-delay)}.ae-editorial-card__picture{overflow:hidden;aspect-ratio:4/5;position:relative;background:#12151b}.ae-editorial-card__picture img{width:100%;height:100%;object-fit:cover;transition:transform 1.5s cubic-bezier(.2,.6,.2,1)}.ae-editorial-card:hover img{transform:scale(1.04)}.ae-editorial-card__index{position:absolute;left:22px;top:22px;font-size:10px;color:#fff;letter-spacing:.1em}.ae-editorial-card__copy{position:relative;padding:24px 0;border-bottom:1px solid #7d71543b}.ae-editorial-card h3{font:400 clamp(26px,3vw,43px)/1.1 var(--ae-font);margin:0 0 12px;letter-spacing:-.03em;color:inherit}.ae-editorial-card__copy p{font-size:11px;line-height:1.7;color:#726d60;margin:0}.ae-editorial-card__copy>span{position:absolute;right:4px;top:33px;font-size:22px}.ae-visual-note{font-size:9px;letter-spacing:.025em;color:#8b8375;margin:34px auto 0;line-height:1.7;max-width:700px}
  .ae-signature{padding:115px 8vw 130px;text-align:center;background:radial-gradient(ellipse at 50% 130%,#403020,#10100e 64%);color:#f1e8da}.ae-signature>.ae-kicker{justify-content:center;color:#baa88e}.ae-signature h2{font:400 clamp(38px,5vw,73px)/1.12 var(--ae-font);letter-spacing:-.035em;margin:0 auto;max-width:850px;color:inherit}.ae-signature__line{width:1px;height:64px;margin:35px auto;background:linear-gradient(#baa88e,transparent)}.ae-signature>p:not(.ae-kicker){max-width:46ch;margin:0 auto 32px;font-size:13px;line-height:1.9;color:#baafa0}.ae-home.is-enhanced .ae-editorial-card:not(.is-seen){opacity:0;transform:translateY(45px)}
  @keyframes ae-watch-breath{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-12px) rotate(-1deg)}}@keyframes ae-down{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}
  .ae-home.is-paused .ae-orbit__watch img,.ae-home.is-paused .ae-scroll>span{animation-play-state:paused}
  @media(max-width:1100px){.ae-hero{min-height:670px}.ae-hero__copy{left:5vw;width:47%}.ae-copy h2{font-size:80px}.ae-orbit{left:40%;right:-7%}.ae-button{font-size:10px;padding:14px 16px;gap:15px}.ae-actions{gap:8px}.ae-hero__bottom{grid-template-columns:1fr auto}.ae-scroll{display:none}.ae-universes{gap:23px}}
  @media(max-width:749px){.ae-hero{height:calc(100svh - 90px);min-height:780px;max-height:none}.ae-hero__top{top:22px;left:23px;right:23px;font-size:8px;letter-spacing:.14em}.ae-hero__top>span:last-child{display:none}.ae-scene{background-position:60% center}.ae-scene--water{background-position:58% center}.ae-scene--air{background-position:54% center}.ae-hero__veil{background:linear-gradient(0deg,#04070af2 0%,#04070ab8 31%,#04070a19 68%,#04070a35)}.ae-orbit{inset:6% 4% 38%}.ae-orbit__watch{inset:0 20% 2%}.ae-hero__copy{top:auto;bottom:117px;left:24px;right:24px;width:auto;transform:none;text-align:center}.ae-kicker{font-size:8px;gap:9px;margin-bottom:16px}.ae-copy .ae-kicker{justify-content:center}.ae-copy h2{font-size:65px;margin-bottom:12px}.ae-copy__hook{font-size:24px;margin-bottom:11px}.ae-copy__body{display:none}.ae-actions{margin-top:24px;justify-content:center;gap:8px}.ae-button{padding:14px 16px;font-size:10px;gap:15px}.ae-hero__bottom{left:24px;right:24px;bottom:20px;gap:16px}.ae-universes{gap:17px;justify-content:center}.ae-universes button{min-width:0;font-size:10px;gap:7px;padding-bottom:16px}.ae-pause{width:35px;height:35px}.ae-manifesto{padding:70px 23px 48px}.ae-manifesto h2{font-size:42px}.ae-manifesto__body{font-size:12px;margin-bottom:36px}.ae-editorial-grid{grid-template-columns:1fr;gap:38px}.ae-editorial-card__picture{aspect-ratio:4/4.5}.ae-editorial-card h3{font-size:36px}.ae-editorial-card__copy{padding:19px 0}.ae-signature{padding:75px 26px 90px}.ae-signature h2{font-size:39px}}
  @media(prefers-reduced-motion:reduce){.ae-home *{animation:none!important;transition:none!important;scroll-behavior:auto!important}.ae-home .ae-editorial-card{opacity:1!important;transform:none!important}.ae-orbit__watch img{transform:none!important}}
{% endstylesheet %}
{% javascript %}
  if (!customElements.get('ardent-elements-home')) {
    customElements.define('ardent-elements-home', class extends HTMLElement {
      connectedCallback() {
        if(this.controller)return;
        this.controller=new AbortController();const signal=this.controller.signal;
        this.index=0;this.turn=0;this.paused=false;this.hover=false;this.focused=false;this.visible=true;this.timer=0;
        this.motion=matchMedia('(prefers-reduced-motion: reduce)');
        this.hero=this.querySelector('.ae-hero');
        this.choices=[...this.querySelectorAll('[data-world-choice]')];this.copies=[...this.querySelectorAll('[data-copy]')];this.watches=[...this.querySelectorAll('[data-watch]')];this.scenes=[...this.querySelectorAll('[data-scene]')];
        this.classList.add('is-enhanced');this.place();
        this.choices.forEach((button,i)=>button.addEventListener('click',()=>{this.select(i,true);this.pause(true);},{signal}));
        this.querySelector('[data-pause]').addEventListener('click',()=>this.pause(!this.paused),{signal});
        this.hero.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'){this.hover=true;this.schedule();}},{signal});
        this.hero.addEventListener('pointerleave',()=>{this.hover=false;this.schedule();},{signal});
        this.hero.addEventListener('focusin',()=>{this.focused=true;this.schedule();},{signal});
        this.hero.addEventListener('focusout',()=>queueMicrotask(()=>{this.focused=this.hero.contains(document.activeElement);this.schedule();}),{signal});
        let start=null;
        this.hero.addEventListener('pointerdown',e=>{if(e.pointerType==='touch'&&!e.target.closest('a,button'))start={x:e.clientX,y:e.clientY};},{signal,passive:true});
        this.hero.addEventListener('pointerup',e=>{if(start){const dx=e.clientX-start.x,dy=e.clientY-start.y;if(Math.abs(dx)>65&&Math.abs(dx)>Math.abs(dy)*1.5){this.select((this.index+(dx<0?1:2))%3,true);this.pause(true);}start=null;}},{signal,passive:true});
        document.addEventListener('visibilitychange',()=>this.schedule(),{signal});this.motion.addEventListener('change',()=>this.schedule(),{signal});
        this.heroObserver=new IntersectionObserver(entries=>{this.visible=entries[0].isIntersecting;this.schedule();},{threshold:.15});this.heroObserver.observe(this.hero);
        this.revealObserver=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-seen');this.revealObserver.unobserve(e.target);}}),{threshold:.1});this.querySelectorAll('.ae-editorial-card').forEach(el=>this.revealObserver.observe(el));
        this.schedule();
      }
      place(){this.watches.forEach((watch,i)=>watch.classList.toggle('is-active',i===this.index));this.scenes.forEach((scene,i)=>scene.classList.toggle('is-active',i===this.index));}
      select(i,manual=false){clearTimeout(this.timer);if(i===this.index){this.schedule();return;}this.index=i;this.dataset.element=['fire','water','air'][i];
        this.copies.forEach((copy,n)=>{copy.classList.toggle('is-active',n===i);copy.inert=n!==i;copy.setAttribute('aria-hidden',String(n!==i));});this.choices.forEach((b,n)=>b.setAttribute('aria-pressed',String(n===i)));this.place();
        if(manual)this.querySelector('[data-world-status]').textContent=this.choices[i].textContent.trim();this.schedule(1400);
      }
      pause(value){this.paused=value;this.classList.toggle('is-paused',value);const btn=this.querySelector('[data-pause]');btn.setAttribute('aria-pressed',String(value));const label=value?this.dataset.playText:this.dataset.pauseText;btn.setAttribute('aria-label',label);this.querySelector('[data-pause-label]').textContent=label;this.querySelector('[data-pause-symbol]').textContent=value?'▷':'Ⅱ';this.schedule();}
      schedule(extra=0){clearTimeout(this.timer);if(this.paused||this.hover||this.focused||!this.visible||document.hidden||this.motion.matches)return;this.timer=setTimeout(()=>this.select((this.index+1)%3),Math.max(2000,Number(this.dataset.dwell)||2000)+extra);}
      disconnectedCallback(){clearTimeout(this.timer);this.controller?.abort();this.heroObserver?.disconnect();this.revealObserver?.disconnect();this.controller=null;}
    });
  }
{% endjavascript %}
{% schema %}
{"name":"Ardent — Les éléments","settings":[{"type":"range","id":"dwell","min":2,"max":8,"step":1,"unit":"s","label":"Temps par univers","default":6}],"presets":[{"name":"Ardent — Les éléments"}]}
{% endschema %}
