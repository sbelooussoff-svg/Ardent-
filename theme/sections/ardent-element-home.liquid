{% javascript %}
  if (!customElements.get('ardent-elements-home')) {
    customElements.define('ardent-elements-home', class extends HTMLElement {
      connectedCallback() {
        if(this.controller)return;
        this.controller=new AbortController();const signal=this.controller.signal;
        this.index=0;this.paused=false;this.visible=true;this.timer=0;
        this.motion=matchMedia('(prefers-reduced-motion: reduce)');
        this.hero=this.querySelector('.ae-hero');
        this.choices=[...this.querySelectorAll('[data-world-choice]')];this.copies=[...this.querySelectorAll('[data-copy]')];this.watches=[...this.querySelectorAll('[data-watch]')];this.scenes=[...this.querySelectorAll('[data-scene]')];this.videos=[...this.querySelectorAll('[data-scene-video]')];
        this.videos.forEach(video=>video.addEventListener('playing',()=>{if(video.parentElement.classList.contains('is-active')&&!this.paused)video.parentElement.classList.add('is-playing');},{signal}));
        this.classList.add('is-enhanced');this.place();
        this.choices.forEach((button,i)=>button.addEventListener('click',()=>this.select(i,true),{signal}));
        this.querySelector('[data-pause]').addEventListener('click',()=>this.pause(!this.paused),{signal});
        let start=null;
        this.hero.addEventListener('pointerdown',e=>{if(e.pointerType==='touch'&&!e.target.closest('a,button'))start={x:e.clientX,y:e.clientY};},{signal,passive:true});
        this.hero.addEventListener('pointerup',e=>{if(start){const dx=e.clientX-start.x,dy=e.clientY-start.y;if(Math.abs(dx)>65&&Math.abs(dx)>Math.abs(dy)*1.5)this.select((this.index+(dx<0?1:2))%3,true);start=null;}},{signal,passive:true});
        document.addEventListener('visibilitychange',()=>this.schedule(),{signal});this.motion.addEventListener('change',()=>this.schedule(),{signal});
        this.heroObserver=new IntersectionObserver(entries=>{this.visible=entries[0].isIntersecting;this.schedule();},{threshold:.15});this.heroObserver.observe(this.hero);
        this.revealObserver=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-seen');this.revealObserver.unobserve(e.target);}}),{threshold:.1});this.querySelectorAll('.ae-editorial-card').forEach(el=>this.revealObserver.observe(el));
        this.productVideos=[...this.querySelectorAll('[data-product-video]')];this.productVisible=new Set();
        this.productVideos.forEach(video=>video.addEventListener('playing',()=>{if(this.productVisible.has(video)&&!this.paused)video.parentElement.classList.add('is-playing');},{signal}));
        this.productObserver=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)this.productVisible.add(e.target);else this.productVisible.delete(e.target);});this.syncProductVideos();},{threshold:.2});this.productVideos.forEach(video=>this.productObserver.observe(video));
        this.schedule();
      }
      place(previous=-1){this.watches.forEach((watch,i)=>{watch.classList.toggle('is-active',i===this.index);watch.classList.toggle('is-exiting',i===previous);});this.scenes.forEach((scene,i)=>scene.classList.toggle('is-active',i===this.index));this.syncVideos(true);}
      select(i,manual=false){clearTimeout(this.timer);if(i===this.index){this.schedule();return;}const previous=this.index;this.index=i;this.dataset.element=['fire','water','air'][i];
        this.copies.forEach((copy,n)=>{copy.classList.toggle('is-active',n===i);copy.inert=n!==i;copy.setAttribute('aria-hidden',String(n!==i));});this.choices.forEach((b,n)=>b.setAttribute('aria-pressed',String(n===i)));this.place(previous);
        if(manual)this.querySelector('[data-world-status]').textContent=this.choices[i].textContent.trim();this.schedule();
      }
      pause(value){this.paused=value;this.classList.toggle('is-paused',value);const btn=this.querySelector('[data-pause]');btn.setAttribute('aria-pressed',String(value));const label=value?this.dataset.playText:this.dataset.pauseText;btn.setAttribute('aria-label',label);this.querySelector('[data-pause-label]').textContent=label;this.querySelector('[data-pause-symbol]').textContent=value?'▷':'Ⅱ';this.schedule();}
      syncVideos(reset=false){this.videos.forEach((video,i)=>{const active=i===this.index&&!this.paused&&this.visible&&!document.hidden&&!this.motion.matches;if(active){if(reset&&video.readyState)video.currentTime=0;if(video.paused)video.play().catch(()=>{});}else{video.pause();video.parentElement.classList.remove('is-playing');}});}
      syncProductVideos(){this.productVideos?.forEach(video=>{const active=this.productVisible.has(video)&&!this.paused&&!document.hidden&&!this.motion.matches;if(active){if(video.paused)video.play().catch(()=>{});}else{video.pause();video.parentElement.classList.remove('is-playing');}});}
      schedule(){clearTimeout(this.timer);this.syncVideos();this.syncProductVideos();if(this.paused||!this.visible||document.hidden||this.motion.matches)return;this.timer=setTimeout(()=>this.select((this.index+1)%3),Math.max(2000,Number(this.dataset.dwell)||2000));}
      disconnectedCallback(){clearTimeout(this.timer);this.videos?.forEach(video=>video.pause());this.productVideos?.forEach(video=>video.pause());this.controller?.abort();this.heroObserver?.disconnect();this.revealObserver?.disconnect();this.productObserver?.disconnect();this.controller=null;}
    });
  }
