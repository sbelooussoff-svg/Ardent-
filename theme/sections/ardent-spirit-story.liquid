{% liquid
  assign hero_image = section.settings.hero_image
  assign portrait_image = section.settings.portrait_image
  assign style_image = section.settings.style_image
  assign configurator_image = section.settings.configurator_image
  assign closing_image = section.settings.closing_image
  assign hero_alt = 'ardent.spirit.images.hero_alt' | t
  assign portrait_alt = 'ardent.spirit.images.portrait_alt' | t
  assign style_alt = 'ardent.spirit.images.style_alt' | t
  assign configurator_alt = 'ardent.spirit.images.configurator_alt' | t
  assign closing_alt = 'ardent.spirit.images.closing_alt' | t
%}

<ardent-spirit-story class="ardent-spirit" {{ section.shopify_attributes }}>
  <header class="ardent-spirit__hero">
    <div class="ardent-spirit__hero-media">
      {% if hero_image != blank %}
        {{ hero_image | image_url: width: 2400 | image_tag: class: 'ardent-spirit__image', loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1600, 2000, 2400', sizes: '100vw', alt: hero_alt }}
      {% endif %}
    </div>
    <div class="ardent-spirit__hero-tint"></div>
    <div class="ardent-spirit__hero-copy">
      <p class="ardent-spirit__eyebrow" data-spirit-reveal>{{ 'ardent.spirit.hero.eyebrow' | t }}</p>
      <h1 data-spirit-reveal>{{ 'ardent.spirit.hero.title' | t }}</h1>
      <p class="ardent-spirit__hero-lead" data-spirit-reveal>{{ 'ardent.spirit.hero.lead' | t }}</p>
    </div>
  </header>

  <section class="ardent-spirit__manifesto">
    <p class="ardent-spirit__eyebrow" data-spirit-reveal>{{ 'ardent.spirit.manifesto.eyebrow' | t }}</p>
    <div class="ardent-spirit__words" aria-label="{{ 'ardent.spirit.manifesto.aria' | t }}">
      <span data-spirit-reveal>{{ 'ardent.spirit.manifesto.first' | t }}</span>
      <span data-spirit-reveal>{{ 'ardent.spirit.manifesto.second' | t }}</span>
      <span data-spirit-reveal>{{ 'ardent.spirit.manifesto.third' | t }}</span>
    </div>
    <p class="ardent-spirit__manifesto-copy" data-spirit-reveal>{{ 'ardent.spirit.manifesto.copy' | t }}</p>
  </section>

  <section class="ardent-spirit__portrait">
    <figure class="ardent-spirit__portrait-image" data-spirit-reveal>
      {% if portrait_image != blank %}
        {{ portrait_image | image_url: width: 1800 | image_tag: class: 'ardent-spirit__image', loading: 'lazy', widths: '600, 900, 1300, 1800', sizes: '(min-width: 990px) 55vw, 92vw', alt: portrait_alt }}
      {% else %}
        <div class="ardent-spirit__placeholder"></div>
      {% endif %}
    </figure>
    <div class="ardent-spirit__portrait-copy" data-spirit-reveal>
      <p class="ardent-spirit__eyebrow">{{ 'ardent.spirit.portrait.eyebrow' | t }}</p>
      <h2>{{ 'ardent.spirit.portrait.title' | t }}</h2>
      <p>{{ 'ardent.spirit.portrait.copy' | t }}</p>
    </div>
  </section>

  <section class="ardent-spirit__style">
    <div class="ardent-spirit__style-copy" data-spirit-reveal>
      <p class="ardent-spirit__eyebrow">{{ 'ardent.spirit.style.eyebrow' | t }}</p>
      <h2>{{ 'ardent.spirit.style.title' | t }}</h2>
      <p>{{ 'ardent.spirit.style.copy' | t }}</p>
    </div>
    <figure class="ardent-spirit__style-image" data-spirit-reveal>
      {% if style_image != blank %}
        {{ style_image | image_url: width: 1600 | image_tag: class: 'ardent-spirit__image', loading: 'lazy', widths: '500, 750, 1100, 1600', sizes: '(min-width: 990px) 34vw, 82vw', alt: style_alt }}
      {% else %}
        <div class="ardent-spirit__placeholder"></div>
      {% endif %}
    </figure>
  </section>

  <section class="ardent-spirit__configurator">
    <div class="ardent-spirit__configurator-image">
      {% if configurator_image != blank %}
        {{ configurator_image | image_url: width: 2200 | image_tag: class: 'ardent-spirit__image', loading: 'lazy', widths: '750, 1100, 1600, 2200', sizes: '100vw', alt: configurator_alt }}
      {% else %}
        <div class="ardent-spirit__placeholder"></div>
      {% endif %}
    </div>
    <div class="ardent-spirit__configurator-card" data-spirit-reveal>
      <p class="ardent-spirit__eyebrow">{{ 'ardent.spirit.configurator.eyebrow' | t }}</p>
      <h2>{{ 'ardent.spirit.configurator.title' | t }}</h2>
      <p>{{ 'ardent.spirit.configurator.copy' | t }}</p>
      <span class="ardent-spirit__soon">{{ 'ardent.spirit.configurator.soon' | t }}</span>
    </div>
  </section>

  <section class="ardent-spirit__closing">
    <figure class="ardent-spirit__closing-image">
      {% if closing_image != blank %}
        {{ closing_image | image_url: width: 2200 | image_tag: class: 'ardent-spirit__image', loading: 'lazy', widths: '750, 1100, 1600, 2200', sizes: '100vw', alt: closing_alt }}
      {% else %}
        <div class="ardent-spirit__placeholder"></div>
      {% endif %}
    </figure>
    <div class="ardent-spirit__closing-copy">
      <p class="ardent-spirit__eyebrow" data-spirit-reveal>{{ 'ardent.spirit.closing.eyebrow' | t }}</p>
      <p class="ardent-spirit__quote" data-spirit-reveal>{{ 'ardent.spirit.closing.quote' | t }}</p>
    </div>
  </section>
</ardent-spirit-story>

{% stylesheet %}
.ardent-spirit{--ink:#121011;--stone:#ede8e1;--rose:#bd8579;background:var(--stone);color:var(--ink);display:block;overflow:clip}.ardent-spirit__hero,.ardent-spirit__configurator,.ardent-spirit__closing{background:var(--ink);color:#fff;position:relative}.ardent-spirit__hero{align-items:flex-end;display:flex;isolation:isolate;min-height:min(900px,100svh);padding:clamp(28px,7vw,112px)}.ardent-spirit__hero-media,.ardent-spirit__hero-tint,.ardent-spirit__closing-image,.ardent-spirit__closing-copy{inset:0;position:absolute}.ardent-spirit__hero-media,.ardent-spirit__closing-image{overflow:hidden}.ardent-spirit__hero-media:after,.ardent-spirit__closing-image:after{background:linear-gradient(0deg,rgba(12,10,10,.72),transparent 65%);content:'';inset:0;position:absolute}.ardent-spirit__hero-tint{background:radial-gradient(circle at 75% 20%,rgba(189,133,121,.25),transparent 32%)}.ardent-spirit__image{display:block;height:100%;object-fit:cover;width:100%}.ardent-spirit__hero-copy{max-width:900px;position:relative;z-index:1}.ardent-spirit__eyebrow{color:var(--rose);font-size:.68rem;font-weight:600;letter-spacing:.2em;margin:0 0 18px;text-transform:uppercase}.ardent-spirit h1,.ardent-spirit h2,.ardent-spirit__words span,.ardent-spirit__quote{font-family:var(--font-heading--family,Georgia,serif);font-weight:400}.ardent-spirit h1{font-size:clamp(4.4rem,12vw,11rem);letter-spacing:-.07em;line-height:.8;margin:0}.ardent-spirit__hero-lead{font-size:clamp(1rem,1.5vw,1.25rem);line-height:1.55;margin:36px 0 0;max-width:460px}.ardent-spirit__manifesto{background:#fff;padding:clamp(92px,15vw,230px) clamp(24px,7vw,110px)}.ardent-spirit__words{margin:0 auto;max-width:1450px}.ardent-spirit__words span{border-bottom:1px solid rgba(18,16,17,.2);display:block;font-size:clamp(3.5rem,10.5vw,10rem);letter-spacing:-.075em;line-height:.82;padding:10px 0}.ardent-spirit__words span:nth-child(2){color:var(--rose);padding-left:12%}.ardent-spirit__words span:nth-child(3){padding-left:28%}.ardent-spirit__manifesto-copy{font-size:clamp(1.2rem,2vw,1.75rem);line-height:1.45;margin:clamp(52px,9vw,130px) 8% 0 auto;max-width:570px}.ardent-spirit__portrait,.ardent-spirit__style{align-items:center;display:grid;gap:clamp(42px,9vw,160px);margin:0 auto;max-width:1520px;padding:clamp(90px,15vw,230px) clamp(24px,7vw,110px)}.ardent-spirit__portrait{grid-template-columns:minmax(300px,1.2fr) minmax(0,.8fr)}.ardent-spirit__portrait-image{aspect-ratio:4/5;margin:0}.ardent-spirit__portrait-copy{max-width:460px}.ardent-spirit h2{font-size:clamp(2.8rem,5vw,5.6rem);letter-spacing:-.06em;line-height:.9;margin:0 0 28px}.ardent-spirit__portrait-copy>p:not(.ardent-spirit__eyebrow),.ardent-spirit__style-copy>p:not(.ardent-spirit__eyebrow){font-size:1.05rem;line-height:1.7;margin:0}.ardent-spirit__style{background:#ddd5cb;grid-template-columns:minmax(0,.9fr) minmax(250px,.65fr);max-width:none}.ardent-spirit__style-copy{justify-self:end;max-width:585px}.ardent-spirit__style-image{aspect-ratio:1/1.25;margin:0}.ardent-spirit__placeholder{background:linear-gradient(145deg,rgba(189,133,121,.4),transparent 58%),#242022;height:100%;position:relative;width:100%}.ardent-spirit__placeholder:after{border:1px solid rgba(255,255,255,.25);content:'';inset:9%;position:absolute}.ardent-spirit__configurator{isolation:isolate;min-height:min(900px,90svh)}.ardent-spirit__configurator-image{inset:0;position:absolute}.ardent-spirit__configurator-image:after{background:linear-gradient(90deg,rgba(12,10,10,.76),rgba(12,10,10,.08));content:'';inset:0;position:absolute}.ardent-spirit__configurator-card{background:rgba(20,17,16,.92);border:1px solid rgba(255,255,255,.22);bottom:clamp(28px,8vw,122px);max-width:460px;padding:clamp(30px,4vw,60px);position:absolute;right:clamp(24px,8vw,122px);z-index:1}.ardent-spirit__configurator-card h2{font-size:clamp(2.5rem,4vw,4.6rem)}.ardent-spirit__configurator-card p:not(.ardent-spirit__eyebrow){line-height:1.6;margin:0}.ardent-spirit__soon{border-bottom:1px solid var(--rose);color:var(--rose);display:inline-block;font-size:.72rem;letter-spacing:.15em;margin-top:32px;padding-bottom:8px;text-transform:uppercase}.ardent-spirit__closing{min-height:min(780px,82svh)}.ardent-spirit__closing-copy{align-items:center;display:flex;flex-direction:column;justify-content:center;padding:28px;text-align:center;z-index:1}.ardent-spirit__closing-copy .ardent-spirit__eyebrow{color:#fff}.ardent-spirit__quote{font-size:clamp(3.2rem,8vw,8rem);letter-spacing:-.07em;line-height:.85;margin:0;max-width:1150px}[data-spirit-reveal]{opacity:0;transform:translateY(30px);transition:opacity .85s cubic-bezier(.2,.65,.2,1),transform .85s cubic-bezier(.2,.65,.2,1)}[data-spirit-reveal].is-visible{opacity:1;transform:none}@media(max-width:749px){.ardent-spirit__hero{min-height:680px}.ardent-spirit h1{font-size:clamp(4rem,20vw,6.5rem)}.ardent-spirit__words span{font-size:clamp(3.15rem,16vw,5.5rem)}.ardent-spirit__words span:nth-child(2){padding-left:8%}.ardent-spirit__words span:nth-child(3){padding-left:16%}.ardent-spirit__portrait,.ardent-spirit__style{grid-template-columns:1fr}.ardent-spirit__portrait-image{grid-row:1}.ardent-spirit__style-copy{justify-self:start}.ardent-spirit__configurator{min-height:660px}.ardent-spirit__configurator-card{bottom:24px;left:24px;right:24px}.ardent-spirit__quote{font-size:clamp(3rem,14vw,5rem)}}@media(prefers-reduced-motion:reduce){[data-spirit-reveal]{opacity:1;transform:none;transition:none}}
{% endstylesheet %}

{% javascript %}
class ArdentSpiritStory extends HTMLElement {
  connectedCallback() {
    const elements = this.querySelectorAll('[data-spirit-reveal]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.16 });
    elements.forEach((element) => observer.observe(element));
    this.observer = observer;
  }
  disconnectedCallback() {
    if (this.observer) this.observer.disconnect();
  }
}
if (!customElements.get('ardent-spirit-story')) customElements.define('ardent-spirit-story', ArdentSpiritStory);
{% endjavascript %}

{% schema %}
{
  "name": "Ardent — L’esprit",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Image héro grand format" },
    { "type": "image_picker", "id": "portrait_image", "label": "Image portrait ou lifestyle" },
    { "type": "image_picker", "id": "style_image", "label": "Image détail de style" },
    { "type": "image_picker", "id": "configurator_image", "label": "Image promesse configurateur" },
    { "type": "image_picker", "id": "closing_image", "label": "Image de conclusion" }
  ],
  "presets": [{ "name": "Ardent — L’esprit" }]
}
{% endschema %}
