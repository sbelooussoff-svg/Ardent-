<section class="ardent-atelier-film" data-ardent-atelier-film>
  <div class="ardent-atelier-film__stage">
    <div class="ardent-atelier-film__architecture" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="ardent-atelier-film__art" aria-hidden="true">
      <img src="https://cdn.shopify.com/s/files/1/1033/9267/4139/files/ardent-meridien-travertine-v1.png?v=1789587048" alt="" width="1536" height="2048" loading="lazy">
      <span class="ardent-atelier-film__sun"></span>
    </div>
    <div class="ardent-atelier-film__caption">
      <p class="ardent-atelier-film__number">MÉRIDIEN <span>/</span> 01</p>
      <p class="ardent-atelier-film__eyebrow">L’ARCHITECTURE DU TEMPS</p>
      <h2>Taillée<br>pour <em>marquer.</em></h2>
      <p class="ardent-atelier-film__body">Lignes franches. Métal vivant. Une présence qui ne demande pas la permission.</p>
      <a href="{{ collections['montres-ardent'].url | default: routes.all_products_collection_url }}" class="ardent-atelier-film__cta">Explorer Méridien <span aria-hidden="true">↗</span></a>
    </div>
    <p class="ardent-atelier-film__scroll" aria-hidden="true"><span>FAITES DÉFILER</span><i></i></p>
  </div>
</section>

{% stylesheet %}
  .ardent-atelier-film { --p: 0; position: relative; height: 235svh; background: #e1c19b; color: #211811; }
  .ardent-atelier-film__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; isolation: isolate; background: #c19b74; }
  .ardent-atelier-film__art { position: absolute; z-index: 1; inset: 0; clip-path: inset(0 calc((1 - var(--p)) * 43%) 0 0); }
  .ardent-atelier-film__art img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: calc(52% + var(--p) * 10%) 50%; transform: scale(calc(1.12 - var(--p) * .12)); filter: contrast(1.04) saturate(.91); will-change: transform; }
  .ardent-atelier-film__sun { position: absolute; inset: 0; opacity: calc(.08 + var(--p) * .22); background: linear-gradient(110deg, transparent 35%, rgba(255, 248, 228, .72) 48%, transparent 58%); mix-blend-mode: screen; transform: translateX(calc(-80% + var(--p) * 110%)); }
  .ardent-atelier-film__architecture { position: absolute; z-index: 3; inset: 0; display: flex; justify-content: flex-end; pointer-events: none; }
  .ardent-atelier-film__architecture span { width: 5.9%; height: 100%; border-left: 1px solid rgba(60, 38, 23, .22); background: linear-gradient(90deg, rgba(255, 237, 205, .11), rgba(67, 38, 19, .13)); transform: translateY(calc((1 - var(--p)) * 13%)); opacity: calc(var(--p) * .88); }
  .ardent-atelier-film__architecture span:nth-child(odd) { transform: translateY(calc((1 - var(--p)) * -15%)); }
  .ardent-atelier-film__caption { position: absolute; z-index: 4; top: 50%; left: clamp(1.4rem, 8vw, 10rem); width: min(38rem, 46vw); transform: translateY(calc(-50% + (1 - var(--p)) * 5rem)); opacity: min(1, calc(var(--p) * 2.15)); }
  .ardent-atelier-film__number { margin: 0 0 clamp(2rem, 8vh, 5rem); font: 600 .62rem/1 Arial, sans-serif; letter-spacing: .25em; }
  .ardent-atelier-film__number span { margin: 0 .5rem; color: #a85c30; }
  .ardent-atelier-film__eyebrow { margin: 0 0 1.2rem; color: #8e4725; font: 700 .61rem/1 Arial, sans-serif; letter-spacing: .24em; }
  .ardent-atelier-film h2 { margin: 0; font: 400 clamp(4.2rem, 8.2vw, 9.8rem)/.78 var(--font-heading-family, Georgia, serif); letter-spacing: -.095em; }
  .ardent-atelier-film h2 em { color: #a4562e; font-weight: 400; }
  .ardent-atelier-film__body { max-width: 18rem; margin: 1.8rem 0 0; font: 400 1rem/1.6 var(--font-body-family, Arial, sans-serif); }
  .ardent-atelier-film__cta { display: inline-flex; align-items: center; gap: .9rem; margin-top: 2.1rem; padding-bottom: .65rem; border-bottom: 1px solid #392317; color: #211811; text-decoration: none; font: 700 .65rem/1 Arial, sans-serif; letter-spacing: .16em; text-transform: uppercase; }
  .ardent-atelier-film__cta span { color: #9b4e27; font-size: 1.1rem; transition: transform .25s ease; }
  .ardent-atelier-film__cta:hover span { transform: translate(4px, -4px); }
  .ardent-atelier-film__scroll { position: absolute; z-index: 5; right: clamp(1.3rem, 4vw, 4.5rem); bottom: 2rem; display: flex; align-items: center; gap: .8rem; margin: 0; color: rgba(33, 24, 17, .64); font: 700 .55rem/1 Arial, sans-serif; letter-spacing: .2em; }
  .ardent-atelier-film__scroll i { display: block; width: 3.5rem; height: 1px; background: #8f4c28; transform-origin: left; transform: scaleX(calc(.2 + var(--p) * .8)); }
  @media (max-width: 749px) { .ardent-atelier-film { height: 205svh; } .ardent-atelier-film__art { clip-path: inset(0 0 calc((1 - var(--p)) * 54%) 0); } .ardent-atelier-film__art img { object-position: 59% 50%; transform: scale(calc(1.17 - var(--p) * .14)); } .ardent-atelier-film__architecture { display: none; } .ardent-atelier-film__caption { top: auto; bottom: 7%; left: 1.4rem; width: min(88vw, 25rem); transform: translateY(calc((1 - var(--p)) * 3rem)); } .ardent-atelier-film__number { margin-bottom: 1.7rem; } .ardent-atelier-film h2 { font-size: clamp(4rem, 16vw, 6.2rem); } .ardent-atelier-film__body { display: none; } .ardent-atelier-film__scroll { display: none; } }
  @media (prefers-reduced-motion: reduce) { .ardent-atelier-film { height: 100svh; } .ardent-atelier-film__stage { position: relative; } .ardent-atelier-film__art { clip-path: none; } .ardent-atelier-film__art img { transform: none; } .ardent-atelier-film__architecture { display: none; } .ardent-atelier-film__caption { opacity: 1; transform: translateY(-50%); } }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-ardent-atelier-film]').forEach((section) => {
    if (section.dataset.ready) return;
    section.dataset.ready = 'true';
    const update = () => {
      const rect = section.getBoundingClientRect();
      const distance = section.offsetHeight - window.innerHeight;
      const progress = Math.max(0, Math.min(1, -rect.top / Math.max(distance, 1)));
      section.style.setProperty('--p', progress.toFixed(4));
    };
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => { update(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });
    update();
  });
{% endjavascript %}

{% schema %}
{"name":"Ardent — Méridien","tag":"section","class":"section-ardent-details","settings":[],"presets":[{"name":"Ardent — Méridien"}]}
{% endschema %}
